# Copy to .env.prod and fill every value. Never commit the real file.
# Generate secrets with: openssl rand -hex 32

POSTGRES_PASSWORD=
# HS256 signing key, at least 32 bytes. Must differ between staging and prod.
JWT_SECRET=

# Admin account the seed job upserts and the smoke test signs in with.
SEED_ADMIN_EMAIL=admin@gallery.local
SEED_ADMIN_PASSWORD=
