DATABASE_URL=postgres://gallery:gallery@localhost:5432/gallery
RUST_LOG=info,gallery_api=debug,tower_http=debug,sqlx=warn

# HS256 signing secret for JWTs. Must be at least 32 bytes. For local dev,
# generate with: `openssl rand -hex 32` or `head -c 32 /dev/urandom | base64`.
JWT_SECRET=dev-only-do-not-use-this-replace-me-please-32b
