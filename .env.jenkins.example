# Copy to .env.jenkins. scripts/ci-up.sh creates it for you with random passwords.

# gid of /var/run/docker.sock on the host: stat -c %g /var/run/docker.sock
DOCKER_GID=

JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=
JENKINS_URL=http://localhost:8090/

# Repository the pipeline job checks out.
GALLERY_REPO_URL=https://github.com/m1chael-pappas/aboriginal-art-gallery.git
# SSH remote the Release stage pushes version tags to, using the github-deploy-key credential.
GALLERY_PUSH_URL=git@github.com:m1chael-pappas/aboriginal-art-gallery.git

SONAR_DB_PASSWORD=
SONAR_ADMIN_PASSWORD=
# Written by scripts/sonar-bootstrap.sh.
SONAR_TOKEN=

# Datadog: Organization Settings > API Keys and Application Keys.
DD_SITE=datadoghq.com
DD_API_KEY=
DD_APP_KEY=
# Address that receives monitor notifications.
ALERT_EMAIL=
